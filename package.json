{
  "name": "test-wallet-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:coverage": "ng test --coverage",
    "lint": "ng lint",
    "generate:apis": "npm run generate:issuer-api && npm run generate:verifier-api && npm run generate:trust-business-api && npm run generate:trust-data-api",
    "generate:issuer-api": "openapi-generator-cli generate -i openapi-spec/issuer-api.yaml -g typescript-angular -o src/generated/issuer --additional-properties=providedInRoot=true --skip-validate-spec",
    "generate:trust-business-api": "openapi-generator-cli generate -i openapi-spec/trust-api.yaml -g typescript-angular -o src/generated/trust --additional-properties=providedInRoot=true --skip-validate-spec",
    "generate:trust-data-api": "openapi-generator-cli generate -i openapi-spec/trust-data-api.yaml -g typescript-angular -o src/generated/trust-data --additional-properties=providedInRoot=true --skip-validate-spec",
    "generate:verifier-api": "openapi-generator-cli generate -i openapi-spec/verifier-api.yaml -g typescript-angular -o src/generated/verifier --additional-properties=providedInRoot=true --skip-validate-spec",
    "clean:generated": "rm -rf src/generated"
  },
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource/roboto": "^5.2.10",
    "@sd-jwt/present": "^0.19.0",
    "@sd-jwt/utils": "^0.19.0",
    "jose": "^6.2.1",
    "material-icons": "^1.13.14",
    "rxjs": "^7.8.0",
    "service": "^0.1.4",
    "uuid": "^14.0.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "@types/node": "^25.5.0",
    "@vitest/browser": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "angular-eslint": "21.3.1",
    "eslint": "^9.39.1",
    "jsdom": "^29.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.58.0",
    "vitest": "^4.1.4"
  }
}
